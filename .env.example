# =============================================================================
# CallWave Pro - Environment Configuration
# =============================================================================
# Copy this file to ".env" and fill in real values.
#   cp .env.example .env
# NEVER commit your real .env file (it is gitignored).
# =============================================================================

# ---- Runtime ----
# Environment: development | production
NODE_ENV=development

# HTTP port the Express server listens on (Render/Vercel inject PORT automatically)
PORT=3000

# ---- CORS ----
# Comma-separated list of allowed origins, or "*" for any.
# In production set this to your exact frontend URL, e.g. https://app.callwave.io
CORS_ORIGIN=*

# ---- Authentication ----
# Secret used to sign JWT access tokens. MUST be a long random string in prod.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# JWT lifetime (e.g. 1h, 12h, 7d)
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-12 is a good balance). Higher = slower but safer.
BCRYPT_ROUNDS=10

# ---- Logging ----
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Log format: pretty (dev) | json (prod)
LOG_FORMAT=pretty

# ---- Sprint 1B (placeholders — not used yet) ----
# Supabase / PostgreSQL connection (wired up in Sprint 1B)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Object storage for voicemail audio (Sprint 1B)
# S3_BUCKET=
# TURN/STUN relay credentials (Sprint 1B)
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
