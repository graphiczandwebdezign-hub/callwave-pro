# =============================================================================
# CallWave Pro - Environment Configuration
# =============================================================================
# Copy this file to ".env" and fill in real values.
#   cp .env.example .env
# NEVER commit your real .env file (it is gitignored).
#
# Sprint 1B note: Supabase / Storage / Redis are ALL OPTIONAL. Leave them
# blank and the app runs on local JSON files, local FS uploads, and an
# in-memory token store. Set them to go production-grade.
# =============================================================================

# ---- Runtime ----
# Environment: development | production
NODE_ENV=development

# HTTP port the Express server listens on (Render/Vercel inject PORT automatically)
PORT=3000

# ---- CORS ----
# Comma-separated list of allowed origins, or "*" for any.
# In production set this to your exact frontend URL, e.g. https://app.callwave.io
CORS_ORIGIN=*

# ---- Authentication ----
# Secret used to sign JWT access tokens. MUST be a long random string in prod.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# JWT lifetimes (Sprint 1C). Short access + long refresh.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor (10-12 is a good balance). Higher = slower but safer.
BCRYPT_ROUNDS=10

# Require a valid JWT on every Socket.IO connection (Sprint 1B).
# Leave false to keep the legacy permissive (username-only) client working.
SOCKET_AUTH_REQUIRED=false

# ---- Logging ----
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Log format: pretty (dev) | json (prod)
LOG_FORMAT=pretty

# ---- Supabase (optional — persistence) ----
# Project URL, e.g. https://abcdefgh.supabase.co
# Find these in: Supabase dashboard > Project Settings > API
# The SERVICE_ROLE key is used server-side (bypasses RLS). Keep it secret!
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Object storage (optional — voicemail audio) ----
# Provider: local (filesystem) | supabase (Supabase Storage)
# Defaults to 'supabase' when Supabase is enabled + a bucket is set, else 'local'.
# STORAGE_PROVIDER=local
# Supabase Storage bucket name (must exist; created in the dashboard or via schema.sql)
# SUPABASE_STORAGE_BUCKET=voicemails

# ---- Redis (optional — token revocation) ----
# When set, logout revocation is shared across instances/serverless instead of
# in-memory. Example: redis://default:password@host:6379
# REDIS_URL=

# ---- Future sprints (placeholders — not used yet) ----
# TURN/STUN relay credentials
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
